<Window x:Class="ResolutionX.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResolutionX — Diagnóstico"
        Width="640" Height="620"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Diagnóstico" FontSize="22" FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="16,8" />
            <Button DockPanel.Dock="Left" Content="COPIAR DIAGNÓSTICO" Click="OnCopyClick"
                    Style="{DynamicResource AccentButtonStyle}" Padding="16,8" />
            <TextBlock x:Name="CopiedText" VerticalAlignment="Center" Margin="12,0"
                       Style="{StaticResource SecondaryText}" />
        </DockPanel>

        <TextBox x:Name="ReportText" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
