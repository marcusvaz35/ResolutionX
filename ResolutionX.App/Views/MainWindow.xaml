<Window x:Class="ResolutionX.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResolutionX"
        Width="1040" Height="780"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Atualizar" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="14,6" />
                <Button Content="Diagnóstico" Command="{Binding DiagnosticsCommand}" Padding="14,6" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ResolutionX" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Resoluções de tela do Windows, com teste seguro e restauração automática."
                           Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: monitores e resoluções salvas -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MONITORES" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,20">
                    <ListBox ItemsSource="{Binding Monitors}"
                             SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                             MaxHeight="260"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,8">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Gpu.Name}" Style="{StaticResource SecondaryText}"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ResolutionText}" FontSize="18" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}"
                                               FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="2" Text="RESOLUÇÕES SALVAS" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,8,6,6">
                            <Button Content="Adicionar preset" Command="{Binding SavePresetCommand}"
                                    ToolTip="Salva a largura, a altura e a taxa informadas ao lado"
                                    Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="Excluir" Command="{Binding DeletePresetCommand}"
                                    ToolTip="Exclui o preset selecionado (os presets padrão não podem ser excluídos)"
                                    Padding="12,6" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Presets}"
                                 SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="6,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Name}"
                                                   Style="{StaticResource SecondaryText}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding ModeText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Coluna direita: resolução, mensagens e status -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="RESOLUÇÃO" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Resoluções suportadas pelo monitor" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding SelectedMonitor.SupportedModes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Largura" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="5" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Altura" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="5" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Taxa de atualização (Hz)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox IsEditable="True"
                                              ItemsSource="{Binding RefreshRates}"
                                              Text="{Binding RefreshText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton Content="Monitor físico" GroupName="DisplayKind"
                                             IsChecked="{Binding IsPhysical, Mode=TwoWay}" Margin="0,0,20,0" />
                                <RadioButton Content="Monitor virtual" GroupName="DisplayKind"
                                             IsChecked="{Binding IsVirtual, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,14"
                                       Visibility="{Binding IsPhysical, Converter={StaticResource BoolToVisibility}}"
                                       Text="Altera a resolução real enviada ao monitor. Só funciona com modos que o driver aceita." />
                            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,14"
                                       Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Cria um display independente no Windows, com a resolução que você quiser." />
                                <Run Text="{Binding VirtualStatusMessage, Mode=OneWay}" />
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="TESTAR RESOLUÇÃO" Command="{Binding TestCommand}"
                                        HorizontalAlignment="Stretch" Padding="0,10"
                                        ToolTip="Aplica por 15 segundos e volta sozinha se você não confirmar. Vale até reiniciar." />
                                <Button Grid.Column="2" Content="APLICAR" Command="{Binding ApplyCommand}"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Padding="0,10"
                                        ToolTip="Aplica, pede a mesma confirmação de 15 segundos e salva no Windows." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Mensagem de sucesso/informação -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20"
                            Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Mensagem de erro, com detalhes técnicos sob demanda -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20"
                            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ErrorSuggestion}" Style="{StaticResource SecondaryText}"
                                       Margin="0,6,0,0" />
                            <StackPanel Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="Ver detalhes" Command="{Binding ToggleDetailsCommand}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,5" />
                                <TextBox Text="{Binding ErrorDetails, Mode=OneWay}"
                                         Visibility="{Binding DetailsVisible, Converter={StaticResource BoolToVisibility}}"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="12"
                                         MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                         Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="STATUS" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding StatusItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding Glyph}"
                                                   Width="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="Glyph" Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter TargetName="Glyph" Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
